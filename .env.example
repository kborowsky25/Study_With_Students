# Copy to .env and fill in. Never commit .env.
# Production refuses to start unless both keys are random strings of 32+ characters:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173
# Production: the site's address for canonical links (frontend build), e.g. https://www.studywithstudents.co.uk
VITE_SITE_URL=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=users_tutoring
DB_USER=root
DB_PASSWORD=
# Hosted databases (Aiven, TiDB…) need TLS: the host's CA certificate, pasted in full, or a path to it
DB_SSL_CA=

# Super-admin account (gets /superadmin) and header secret for admin API calls (32+ characters)
SUPER_ADMIN_EMAIL=
ADMIN_SECRET=

# SMTP — leave blank in development: verification codes print to the terminal
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional sender, e.g. Study with Students <hello@example.com> (defaults to MAIL_USERNAME)
MAIL_FROM=

# Stripe — leave blank in development (card payments are then switched off)
STRIPE_SECRET_KEY=
# Signing secret (whsec_…) of the Stripe webhook endpoint for /api/payments/webhook
STRIPE_WEBHOOK_SECRET=

# Reminder emails: a GitHub Actions job calls /api/cron/reminders with this secret
CRON_SECRET=
