# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=users_tutoring
DB_USER=root
DB_PASSWORD=

# Super-admin account (gets /superadmin) and header secret for admin API calls
SUPER_ADMIN_EMAIL=
ADMIN_SECRET=

# SMTP — leave blank in development: verification codes print to the terminal
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Stripe — leave blank in development to use the demo Explorer activation
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
