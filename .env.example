# Copy to .env and fill in. Never commit .env.
# Production refuses to start unless both keys are random strings of 32+ characters:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=users_tutoring
DB_USER=root
DB_PASSWORD=

# Super-admin account (gets /superadmin) and header secret for admin API calls (32+ characters)
SUPER_ADMIN_EMAIL=
ADMIN_SECRET=

# SMTP — leave blank in development: verification codes print to the terminal
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Stripe — leave blank in development (card payments are then switched off)
STRIPE_SECRET_KEY=
# Signing secret (whsec_…) of the Stripe webhook endpoint for /api/payments/webhook
STRIPE_WEBHOOK_SECRET=
